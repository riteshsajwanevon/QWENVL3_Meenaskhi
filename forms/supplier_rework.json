    {
      "key": "part_name",
      "labels": [
        "PART NAME"
      ],
      "type": "text",
      "required": true
    },
    {
      "key": "supplier_name",
      "labels": [
        "SUPPLIER NAME"
      ],
      "type": "text"
    },
    {
      "key": "lot_qty",
      "labels": [
        "LOT QTY"
      ],
      "type": "int",
      "required": true
    },
    {
      "key": "rework_qty",
      "labels": [
        "REWORK QTY"
      ],
      "type": "int",
      "required": true
    },
    {
      "key": "ok_qty",
      "labels": [
        "OK QTY"
      ],
      "type": "int",
      "required": true
    },
    {
      "key": "problem_description",
      "labels": [
        "PROBLEM DESCRIPTION"
      ],
      "type": "text"
    },
    {
      "key": "remarks",
      "labels": [
        "REMARKS"
      ],
      "type": "text"
    }
