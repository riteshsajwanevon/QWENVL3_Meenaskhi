{
  "form_id": "supplier_rework",
  "version": 1,
  "name": "Supplier Rework Report",
  "family": "supplier",
  "match": {
    "title_any": [
      "SUPPLIER REWORK REPORT"
    ],
    "title_none": [
      "REWORK & REJECTION SHEET",
      "REWORK AND REJECTION"
    ],
    "columns_any": [
      "DATE",
      "PART NAME",
      "SUPPLIER NAME",
      "LOT QTY",
      "REWORK QTY",
      "OK QTY",
      "PROBLEM DESCRIPTION",
      "REMARKS"
    ]
  },
  "header": {
    "company": [
      "COMPANY"
    ],
    "title": [
      "TITLE"
    ],
    "month": [
      "MONTH"
    ]
  },
  "layout": {
    "kind": "record",
    "header_rows": 3,
    "footer_rows": 1,
    "expected_col_lines": 9
  },
  "columns": [
    {
      "key": "date",
      "labels": [
